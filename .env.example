# Συμπλήρωσε ένα από τα δύο κλειδιά. Vision και Reasoning χρησιμοποιούν αυτόν τον πάροχο.
# Αν και τα δύο κλειδιά έχουν τιμή: gemini ή openrouter. Κενό = gemini.
LLM_PROVIDER=

# OpenRouter: κλειδί από το openrouter.ai (ξεκινά με sk-or-). Κάθε αναφορά κάνει περίπου 6 κλήσεις. Στο δωρεάν όριο των 50 αιτημάτων την ημέρα χωράνε περίπου 8 πλήρεις αναφορές. 
GEMINI_API_KEY=
OPENROUTER_API_KEY=

GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_REASONING_MODEL=gemini-3.6-flash
# Δωρεάν μοντέλο OpenRouter με εικόνα και structured JSON. Άλλο id από το openrouter.ai/models δουλεύει επίσης.
OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_REASONING_MODEL=nvidia/nemotron-3.5-super-vl:free
INTERNAL_WEBHOOK_BASE_URL=http://127.0.0.1:8000/api/webhooks
